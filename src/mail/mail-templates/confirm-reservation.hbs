<html lang='en'>

  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=' />
    <title>{{title}}</title>
  </head>

  <body style='margin:0;font-family:arial'>
    <table style='border:0;width:100%'>
      <tr style='background:#eeeeee'>
        <td
          style='padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600'
        >
          {{app_name}}
        </td>
      </tr>
      <tr>
        <td style='padding:20px;color:#808080;font-size:16px;font-weight:100'>
          {{title}}<br /><br />
          {{subtitle}}
          <br /><br /><br />
          {{details}}
          <br />

          <p>{{fullNameTitle}} {{fullNameUser}}</p>
          <p>{{roomNameTitle}} {{roomName}}-{{roomLocation}}</p>
          <p>{{reservationDateTitle}} {{reservationDate}}</p>
          <p>{{reservationTimeTitle}} {{reservationTime}}</p>
          <p>{{observationTitle}} {{observation}}</p>

          {{#if additionals}}
            <p>{{additionalsTitle}}</p>
            <ul>
              {{#each additionals}}
                <li>Item: {{this.item}} - quantidade: {{this.quantity}}</li>
              {{/each}}
            </ul>
          {{else}}
            <br />
          {{/if}}

        </td>
      </tr>
      <tr>
        <td style='text-align:center'>
          {{#if admin}}
            <a
              href='{{url}}'
              style='display:inline-block;padding:20px;background:#00838f;text-decoration:none;color:#ffffff'
            >{{actionTitle}}</a>
          {{else}}
            <br />
          {{/if}}
        </td><br />
      </tr>

      <tr>
        <td style='padding:24px;color:#808080;text-align:center;font-size:14px'>
          <div style='font-size:32px;font-weight:700;margin-bottom:8px'>RD</div>
          <div>Rabelo Digital — <a href='https://rabelodigital.com'>rabelodigital.com</a></div>
        </td>
      </tr>

    </table>
  </body>

</html>